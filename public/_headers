# Security + caching headers for static files (Worker responses set their own in src/index.js).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com 'sha256-NVKT0UrdROLsGcatClpvEhxXytwpjLyEshzIKuByDnE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://cloudflareinsights.com https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images and brand files change rarely: cache for a month in browsers and at the edge.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
# third-party libraries served from the site itself, one file per version: never change
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.*
  Cache-Control: public, max-age=86400
/og.jpg
  Cache-Control: public, max-age=604800

# Built scripts and styles: browsers always check for a newer version (a cheap 304 from the edge),
# so a fresh page never runs with yesterday's CSS or JS.
/build/*
  Cache-Control: public, no-cache

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=86400
