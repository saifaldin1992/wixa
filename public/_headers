# Security + caching headers for static files (Worker responses set their own in src/index.js).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com 'sha256-NVKT0UrdROLsGcatClpvEhxXytwpjLyEshzIKuByDnE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://cloudflareinsights.com https://*.supabase.co https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images and brand files change rarely: cache for a month in browsers and at the edge.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/brand/png/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/brand/social/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=604800

# Scripts and styles: short browser cache, revalidated in the background.
/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/*.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
